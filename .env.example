# ============================================
# Docker 环境变量配置模板
# 使用方法：复制此文件为 .env，根据需要修改
#   cp .env.example .env
# ============================================

# 数据库
DB_USERNAME=ragkb
DB_PASSWORD=ragkb123
DB_NAME=ragkb
DB_PORT=5432

# 后端端口
BACKEND_PORT=8080

# 前端端口
FRONTEND_PORT=5173

# JWT 签名密钥（生产环境请换成你自定义的随机字符串）
JWT_SECRET=RAGkbDockerSecretKey1234567890_DockerKey

# 管理员初始密码
ADMIN_PASSWORD=123456

# 阿里云百炼 API Key（在线模式需要，离线模式留空即可）
DASHSCOPE_API_KEY=
