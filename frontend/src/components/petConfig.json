{
  "name": "qq-penguin-desktop-pet",
  "version": "1.0.0",
  "description": "QQ企鹅桌面宠物 - 学习监督精灵图配置",
  "author": "Trae Design",
  "spriteConfig": {
    "baseSize": {
      "width": 1024,
      "height": 1024
    },
    "targetSize": {
      "width": 256,
      "height": 256
    },
    "format": "jpg",
    "fps": 8,
    "scaleMode": "fit",
    "imagePrefix": "assets/pet-"
  },
  "animations": {
    "idle": {
      "name": "待机",
      "frames": [
        "idle-01",
        "idle-02",
        "idle-03",
        "idle-04",
        "idle-05",
        "idle-06"
      ],
      "fps": 2,
      "loop": true,
      "priority": 0,
      "description": "呼吸/眨眼循环，默认状态"
    },
    "walk": {
      "name": "行走",
      "frames": [
        "walk-01",
        "walk-02",
        "walk-03",
        "walk-04",
        "walk-05",
        "walk-06",
        "walk-07",
        "walk-08"
      ],
      "fps": 8,
      "loop": true,
      "priority": 1,
      "description": "左右脚交替行走"
    },
    "happy": {
      "name": "开心跳跃",
      "frames": [
        "happy-01",
        "happy-02",
        "happy-03",
        "happy-04",
        "happy-05",
        "happy-06"
      ],
      "fps": 8,
      "loop": true,
      "priority": 3,
      "description": "跳跃摇摆庆祝",
      "transitionTo": "idle"
    },
    "surprised": {
      "name": "惊讶",
      "frames": [
        "surprised-01",
        "surprised-02",
        "surprised-03",
        "surprised-04"
      ],
      "fps": 6,
      "loop": false,
      "priority": 4,
      "description": "瞪眼后仰后恢复",
      "transitionTo": "idle"
    },
    "sleep": {
      "name": "睡觉",
      "frames": [
        "sleep-01",
        "sleep-02",
        "sleep-03",
        "sleep-04",
        "sleep-05",
        "sleep-06"
      ],
      "fps": 2,
      "loop": true,
      "priority": 1,
      "description": "闭眼打呼ZZZ循环"
    },
    "angry": {
      "name": "生气",
      "frames": [
        "angry-01",
        "angry-02",
        "angry-03",
        "angry-04"
      ],
      "fps": 6,
      "loop": false,
      "priority": 4,
      "description": "跺脚冒火逐渐消气",
      "transitionTo": "idle"
    },
    "love": {
      "name": "爱心",
      "frames": [
        "love-01",
        "love-02",
        "love-03",
        "love-04",
        "love-05",
        "love-06"
      ],
      "fps": 6,
      "loop": false,
      "priority": 3,
      "description": "害羞散心沉醉后恢复",
      "transitionTo": "idle"
    },
    "eat": {
      "name": "吃东西",
      "frames": [
        "eat-01",
        "eat-02",
        "eat-03",
        "eat-04",
        "eat-05",
        "eat-06"
      ],
      "fps": 6,
      "loop": false,
      "priority": 3,
      "description": "张嘴咀嚼吃饱满足",
      "transitionTo": "idle"
    },
    "wave": {
      "name": "打招呼",
      "frames": [
        "wave-01",
        "wave-02",
        "wave-03",
        "wave-04"
      ],
      "fps": 6,
      "loop": false,
      "priority": 3,
      "description": "举翅挥动打招呼",
      "transitionTo": "idle"
    },
    "jump": {
      "name": "跳跃",
      "frames": [
        "jump-01",
        "jump-02",
        "jump-03",
        "jump-04",
        "jump-05",
        "jump-06"
      ],
      "fps": 8,
      "loop": true,
      "priority": 3,
      "description": "蹲下蓄力起跳落地循环",
      "transitionTo": "idle"
    },
    "giveheart": {
      "name": "送爱心",
      "frames": [
        "giveheart-01",
        "giveheart-02",
        "giveheart-03",
        "giveheart-04",
        "giveheart-05",
        "giveheart-06"
      ],
      "fps": 6,
      "loop": false,
      "priority": 3,
      "description": "捧心送出爱心飘远",
      "transitionTo": "idle"
    },
    "think": {
      "name": "思考求解",
      "frames": [
        "think-01",
        "think-02",
        "think-03",
        "think-04",
        "think-05",
        "think-06"
      ],
      "fps": 4,
      "loop": false,
      "priority": 2,
      "description": "托腮沉思灵光一闪领悟",
      "transitionTo": "idle"
    },
    "cheer": {
      "name": "学习加油",
      "frames": [
        "cheer-01",
        "cheer-02",
        "cheer-03",
        "cheer-04",
        "cheer-05",
        "cheer-06"
      ],
      "fps": 8,
      "loop": false,
      "priority": 3,
      "description": "戴眼镜举书高呼鼓励",
      "transitionTo": "focus",
      "trigger": "pomodoro_start",
      "triggerLabel": "开始番茄钟"
    },
    "thumbsup": {
      "name": "点个赞",
      "frames": [
        "thumbsup-01",
        "thumbsup-02",
        "thumbsup-03",
        "thumbsup-04"
      ],
      "fps": 6,
      "loop": false,
      "priority": 3,
      "description": "双翅竖大拇指点赞",
      "transitionTo": "idle",
      "trigger": "task_complete",
      "triggerLabel": "完成任务"
    },
    "sleepy": {
      "name": "犯困警告",
      "frames": [
        "sleepy-01",
        "sleepy-02",
        "sleepy-03",
        "sleepy-04"
      ],
      "fps": 4,
      "loop": false,
      "priority": 4,
      "description": "揉眼打盹惊醒拍脸",
      "transitionTo": "focus",
      "trigger": "study_too_long",
      "triggerLabel": "学习过久"
    },
    "nowphone": {
      "name": "放下手机",
      "frames": [
        "nowphone-01",
        "nowphone-02",
        "nowphone-03",
        "nowphone-04"
      ],
      "fps": 5,
      "loop": false,
      "priority": 5,
      "description": "抱臂指责放下手机",
      "transitionTo": "idle",
      "trigger": "distraction_detected",
      "triggerLabel": "检测到分心"
    },
    "sad": {
      "name": "不达标失望",
      "frames": [
        "sad-01",
        "sad-02",
        "sad-03",
        "sad-04"
      ],
      "fps": 4,
      "loop": false,
      "priority": 3,
      "description": "垂头落泪擦泪振作",
      "transitionTo": "idle",
      "trigger": "goal_missed",
      "triggerLabel": "未达标"
    },
    "focus": {
      "name": "认真专注",
      "frames": [
        "focus-01",
        "focus-02",
        "focus-03",
        "focus-04",
        "focus-05",
        "focus-06"
      ],
      "fps": 3,
      "loop": true,
      "priority": 2,
      "description": "戴眼镜坐桌前安静看书",
      "trigger": "studying",
      "triggerLabel": "正在学习"
    }
  },
  "stateMachine": {
    "defaultState": "idle",
    "transitions": {
      "pomodoro_start": {
        "from": [
          "idle",
          "walk",
          "focus"
        ],
        "to": "cheer"
      },
      "studying": {
        "from": "*",
        "to": "focus"
      },
      "task_complete": {
        "from": "*",
        "to": "thumbsup"
      },
      "goal_missed": {
        "from": "*",
        "to": "sad"
      },
      "study_too_long": {
        "from": [
          "focus",
          "idle"
        ],
        "to": "sleepy"
      },
      "distraction_detected": {
        "from": [
          "focus",
          "idle"
        ],
        "to": "nowphone"
      },
      "user_interact": {
        "from": [
          "idle",
          "focus"
        ],
        "to": "wave"
      },
      "user_click": {
        "from": [
          "idle"
        ],
        "to": "happy"
      },
      "user_pet": {
        "from": [
          "idle"
        ],
        "to": "love"
      },
      "user_feed": {
        "from": [
          "idle"
        ],
        "to": "eat"
      },
      "user_scold": {
        "from": [
          "idle"
        ],
        "to": "surprised"
      },
      "idle_timeout": {
        "from": [
          "walk",
          "happy",
          "jump"
        ],
        "to": "idle"
      },
      "night_mode": {
        "from": [
          "idle",
          "focus"
        ],
        "to": "sleep"
      },
      "study_break": {
        "from": [
          "focus"
        ],
        "to": "jump"
      },
      "study_stop": {
        "from": [
          "*"
        ],
        "to": "idle"
      }
    }
  },
  "studyMonitor": {
    "pomodoroDuration": 25,
    "breakDuration": 5,
    "longBreakDuration": 15,
    "pomodorosBeforeLongBreak": 4,
    "sleepyWarningMinutes": 45,
    "nightModeStartHour": 23,
    "nightModeEndHour": 7,
    "dailyGoalCheck": {
      "hours": 4,
      "pomodoros": 8
    }
  },
